# Files in the repo root that must not be served by the pacixp-website worker
# (wrangler.jsonc publishes "." as static assets). gitignore syntax.

# Repo and tooling
.git/
.github/
.claude/
.gitignore
.assetsignore
wrangler.jsonc

# API worker source (deployed separately as pacixp-api)
worker/

# Internal docs (README, CLAUDE.md, branding, attribution, plans)
*.md

# Private or machine-local files. Wrangler does not read .gitignore, so a
# local `wrangler deploy` would otherwise upload them.
images/*_signature.png
images/*_private.*
.wrangler/
node_modules/
.dev.vars*
.env*
